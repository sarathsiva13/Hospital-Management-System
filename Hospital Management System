SELECT * FROM Patients;
SELECT * FROM Doctors;
SELECT
a.appointment_id,
p.patient_name,
d.doctor_name,
a.appointment_date,
a.status
FROM Appointments a
JOIN Patients p
ON a.patient_id=p.patient_id
JOIN Doctors d
ON a.doctor_id=d.doctor_id;
SELECT *
FROM Appointments
WHERE status='Pending';
SELECT *
FROM Billing
WHERE payment_status='Paid';
SELECT SUM(amount)
AS Total_Revenue
FROM Billing
WHERE payment_status='Paid';
SELECT COUNT(*)
AS Total_Patients
FROM Patients;
SELECT
d.doctor_name,
COUNT(a.patient_id)
AS Total_Patients
FROM Doctors d
LEFT JOIN Appointments a
ON d.doctor_id=a.doctor_id
GROUP BY d.doctor_name;
CREATE VIEW Appointment_View AS
SELECT
a.appointment_id,
p.patient_name,
d.doctor_name,
a.appointment_date,
a.status
FROM Appointments a
JOIN Patients p
ON a.patient_id=p.patient_id
JOIN Doctors d
ON a.doctor_id=d.doctor_id;
SELECT * FROM Appointment_View;
DELIMITER //

CREATE PROCEDURE GetPatientDetails(
IN pid INT
)
BEGIN
SELECT *
FROM Patients
WHERE patient_id=pid;
END //

DELIMITER ;
CALL GetPatientDetails(1);
DELIMITER //

CREATE FUNCTION CalculateGST(
bill DECIMAL(10,2)
)
RETURNS DECIMAL(10,2)
DETERMINISTIC
BEGIN
RETURN bill*0.18;
END //

DELIMITER ;
SELECT
amount,
CalculateGST(amount)
AS GST
FROM Billing;
DELIMITER //

CREATE TRIGGER bill_date_trigger
BEFORE INSERT
ON Billing
FOR EACH ROW
BEGIN
SET NEW.bill_date=CURDATE();
END //

DELIMITER ;
CREATE INDEX idx_patient_name
ON Patients(patient_name);
SELECT *
FROM Billing
ORDER BY amount DESC
LIMIT 1;
SELECT
doctor_id,
COUNT(patient_id)
AS Total
FROM Appointments
GROUP BY doctor_id
HAVING COUNT(patient_id)>1;
SELECT
p.patient_name,
a.appointment_date,
d.doctor_name
FROM Patients p
JOIN Appointments a
ON p.patient_id=a.patient_id
JOIN Doctors d
ON d.doctor_id=a.doctor_id
ORDER BY appointment_date;
